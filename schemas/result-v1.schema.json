{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlareKit result v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "requestID",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestID": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "output": {},
    "error": {
      "type": "object",
      "required": [
        "code",
        "stage",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "httpStatus": {
          "type": [
            "integer",
            "null"
          ]
        },
        "requestID": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
